# Local development: `docker compose up --build` works without .env.
# DO NOT use the dev defaults in production.
APP_ENV=development
STORAGE=postgres
HTTP_PORT=8080
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=
TRUSTED_PROXY_CIDR=
PERMALINK_TEMPLATE=
# For production: APP_ENV=production, set a real secret, HTTPS public URL,
# real randomized POSTGRES_PASSWORD and the actual trusted proxy CIDR.
POSTGRES_PASSWORD=
COMMENG_SIGNING_KEY=
# Private Prometheus endpoint (Compose exposes 9090 only to its internal network).
METRICS_ADDR=
# Optional OTLP HTTP collector, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATE=0.1

# ONLY for deliberate high-rate benchmarks: APP_ENV=test, HTTP_ADDR=127.0.0.1:8080
# (never use on an externally reachable server).
# BENCHMARK_DISABLE_RATELIMIT=false
